# TypeSafe AI API Credentials
# Get your API key from https://console.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# Database Configuration
DATABASE_URL=sqlite:///./phishguard.db

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Policy Thresholds
POLICY_RISK_THRESHOLD_HIGH=3.8
POLICY_RISK_THRESHOLD_CRITICAL=4.5
POLICY_CREDENTIAL_THEFT_THRESHOLD=0.70
POLICY_MALICIOUS_URL_THRESHOLD=0.70
POLICY_BEC_THRESHOLD=0.65
POLICY_HUMAN_REVIEW_THRESHOLD=0.60

# Privacy & Compliance
RAW_EMAIL_STORAGE_ENABLED=false
MAX_EMAIL_BODY_SIZE_BYTES=5242880